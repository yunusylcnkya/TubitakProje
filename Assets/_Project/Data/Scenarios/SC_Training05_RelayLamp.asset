  m_Script: {fileID: 11500000, guid: 6af6ae2e3fed98d42b8166fa2fefcf74, type: 3}
  m_Name: SC_Training05_RelayLamp
  m_EditorClassIdentifier: Assembly-CSharp::ScenarioDefinition
  scenarioId: SCENARIO_05_RELAY_LAMP
  displayName: "Yard\u0131mc\u0131 R\u00f6le ile Lamba Kontrol\u00fc"
  description: "R\u00f6le bobini ve normalde a\u00e7\u0131k konta\u011f\u0131n kontrol etti\u011fi lambay\u0131 kurun. START bas\u0131l\u0131yken lamba yanmal\u0131, b\u0131rak\u0131l\u0131nca s\u00f6nmeli. Sigortan\u0131n enerjiyi kesmesini de test edin."
  steps:
  - stepId: STEP_PLACE_SOURCE
    instruction: "\u00dc\u00e7 fazl\u0131 \u015febeke kayna\u011f\u0131n\u0131 panodaki kaynak yuvas\u0131na yerle\u015ftirin."
    stepType: 0
    equipment: {fileID: 11400000, guid: 2063380e2c565b8499ba924598740076, type: 2}
    slotId: SLOT_3PH_SOURCE
    terminalIdA: 
    terminalIdB: 
  - stepId: STEP_PLACE_PSU
    instruction: "24V DC g\u00fc\u00e7 kayna\u011f\u0131n\u0131 yerine yerle\u015ftirin."
    stepType: 0
    equipment: {fileID: 11400000, guid: 150a0d315440f3d48a18d885dad0b65b, type: 2}
    slotId: SLOT_PSU
    terminalIdA: 
    terminalIdB: 
  - stepId: STEP_PLACE_F1
    instruction: "F1 kontrol devresi sigortas\u0131n\u0131 yerine yerle\u015ftirin."
    stepType: 0
    equipment: {fileID: 11400000, guid: 125d863912481d540a07d62931934f88, type: 2}
    slotId: SLOT_F1
    terminalIdA: 
    terminalIdB: 
  - stepId: STEP_PLACE_START
    instruction: "START butonunu yerine yerle\u015ftirin."
    stepType: 0
    equipment: {fileID: 11400000, guid: 203b7b6b61ab30c45acc398354ba87a9, type: 2}
    slotId: SLOT_START
    terminalIdA: 
    terminalIdB: 
  - stepId: STEP_PLACE_R1
    instruction: "R1 yard\u0131mc\u0131 r\u00f6lesini yerine yerle\u015ftirin."
    stepType: 0
    equipment: {fileID: 11400000, guid: dbcc38c19a3ddef4b95c38821bbf80a8, type: 2}
    slotId: SLOT_R1
    terminalIdA: 
    terminalIdB: 
  - stepId: STEP_PLACE_LAMP
    instruction: "Sinyal lambas\u0131n\u0131 yerine yerle\u015ftirin."
    stepType: 0
    equipment: {fileID: 11400000, guid: d4e97b35414e2934f846cde3d5064a4a, type: 2}
    slotId: SLOT_LAMP
    terminalIdA: 
    terminalIdB: 
  - stepId: STEP_WIRE_01
    instruction: "\u00dc\u00e7 fazl\u0131 kayna\u011f\u0131n L1 ucunu g\u00fc\u00e7 kayna\u011f\u0131n\u0131n AC L giri\u015fine ba\u011flay\u0131n."
    stepType: 1
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: SOURCE_L1
    terminalIdB: PSU_AC_L
  - stepId: STEP_WIRE_02
    instruction: "\u00dc\u00e7 fazl\u0131 kayna\u011f\u0131n N ucunu g\u00fc\u00e7 kayna\u011f\u0131n\u0131n AC N giri\u015fine ba\u011flay\u0131n."
    stepType: 1
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: SOURCE_N
    terminalIdB: PSU_AC_N
  - stepId: STEP_WIRE_03
    instruction: "\u015eebeke PE ucunu g\u00fc\u00e7 kayna\u011f\u0131n\u0131n PE giri\u015fine ba\u011flay\u0131n."
    stepType: 1
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: SOURCE_PE
    terminalIdB: PSU_PE
  - stepId: STEP_WIRE_04
    instruction: "PSU +24V terminalini F1 sigortas\u0131n\u0131n 1 numaral\u0131 giri\u015fine ba\u011flay\u0131n."
    stepType: 1
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: PSU_24V
    terminalIdB: F1_1
