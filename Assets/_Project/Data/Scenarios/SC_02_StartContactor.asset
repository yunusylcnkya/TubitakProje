  m_Script: {fileID: 11500000, guid: 6af6ae2e3fed98d42b8166fa2fefcf74, type: 3}
  m_Name: SC_02_StartContactor
  m_EditorClassIdentifier: Assembly-CSharp::ScenarioDefinition
  scenarioId: SCENARIO_02_START_CONTACTOR
  displayName: "START Butonuyla Kontakt\u00f6r Kumandas\u0131"
  description: "6 ekipman, 10 ba\u011flant\u0131 ve 10 fonksiyonel do\u011frulama testiyle START butonunun anl\u0131k kontakt\u00f6r kumandas\u0131n\u0131 \u00f6\u011fretir. M\u00fch\u00fcrleme uygulanmaz."
  steps:
  - stepId: STEP_PLACE_SOURCE
    instruction: "\u00dc\u00e7 fazl\u0131 \u015febeke kayna\u011f\u0131n\u0131 kendi yuvas\u0131na yerle\u015ftirin."
    stepType: 0
    equipment: {fileID: 11400000, guid: 2063380e2c565b8499ba924598740076, type: 2}
    slotId: SLOT_3PH_SOURCE
    terminalIdA: 
    terminalIdB: 
  - stepId: STEP_PLACE_PSU
    instruction: "24V DC g\u00fc\u00e7 kayna\u011f\u0131n\u0131 SLOT_PSU yuvas\u0131na yerle\u015ftirin."
    stepType: 0
    equipment: {fileID: 11400000, guid: 150a0d315440f3d48a18d885dad0b65b, type: 2}
    slotId: SLOT_PSU
    terminalIdA: 
    terminalIdB: 
  - stepId: STEP_PLACE_F1
    instruction: "F1 kontrol devresi sigortas\u0131n\u0131 yerine yerle\u015ftirin."
    stepType: 0
    equipment: {fileID: 11400000, guid: 125d863912481d540a07d62931934f88, type: 2}
    slotId: SLOT_F1
    terminalIdA: 
    terminalIdB: 
  - stepId: STEP_PLACE_START
    instruction: "START butonunu yerine yerle\u015ftirin."
    stepType: 0
    equipment: {fileID: 11400000, guid: 203b7b6b61ab30c45acc398354ba87a9, type: 2}
    slotId: SLOT_START
    terminalIdA: 
    terminalIdB: 
  - stepId: STEP_PLACE_K1
    instruction: "K1 kontakt\u00f6r\u00fcn\u00fc yerine yerle\u015ftirin."
    stepType: 0
    equipment: {fileID: 11400000, guid: ccd902fac2d76d9458a45263bcbdcb8d, type: 2}
    slotId: SLOT_K1
    terminalIdA: 
    terminalIdB: 
  - stepId: STEP_PLACE_LAMP
    instruction: "Sinyal lambas\u0131n\u0131 yerine yerle\u015ftirin."
    stepType: 0
    equipment: {fileID: 11400000, guid: d4e97b35414e2934f846cde3d5064a4a, type: 2}
    slotId: SLOT_LAMP
    terminalIdA: 
    terminalIdB: 
  - stepId: STEP_WIRE_AC_L
    instruction: "\u015eebeke L1 ucunu PSU AC L giri\u015fine ba\u011flay\u0131n."
    stepType: 1
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: SOURCE_L1
    terminalIdB: PSU_AC_L
  - stepId: STEP_WIRE_AC_N
    instruction: "\u015eebeke N ucunu PSU AC N giri\u015fine ba\u011flay\u0131n."
    stepType: 1
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: SOURCE_N
    terminalIdB: PSU_AC_N
  - stepId: STEP_WIRE_AC_PE
    instruction: "\u015eebeke PE ucunu PSU PE terminaline ba\u011flay\u0131n."
    stepType: 1
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: SOURCE_PE
    terminalIdB: PSU_PE
  - stepId: STEP_WIRE_PSU_F1
    instruction: "PSU +24V ucunu F1 giri\u015f (1) terminaline ba\u011flay\u0131n."
    stepType: 1
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: PSU_24V
    terminalIdB: F1_1
  - stepId: STEP_WIRE_F1_START
    instruction: "F1 \u00e7\u0131k\u0131\u015f (2) terminalini START 13 terminaline ba\u011flay\u0131n."
    stepType: 1
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: F1_2
    terminalIdB: S1_13
  - stepId: STEP_WIRE_START_K1
    instruction: "START 14 terminalini K1 A1 bobinine ba\u011flay\u0131n."
    stepType: 1
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: S1_14
    terminalIdB: K1_A1
  - stepId: STEP_WIRE_K1_RETURN
    instruction: "K1 A2 bobin terminalini PSU 0V ucuna ba\u011flay\u0131n."
    stepType: 1
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: K1_A2
    terminalIdB: PSU_0V
  - stepId: STEP_WIRE_F1_K1_23
    instruction: "F1 \u00e7\u0131k\u0131\u015f (2) ucunu K1 yard\u0131mc\u0131 NO konta\u011f\u0131 23 terminaline ba\u011flay\u0131n."
    stepType: 1
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: F1_2
    terminalIdB: K1_23
  - stepId: STEP_WIRE_K1_LAMP
    instruction: "K1 yard\u0131mc\u0131 kontak 24 terminalini lamba A1 terminaline ba\u011flay\u0131n."
    stepType: 1
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: K1_24
    terminalIdB: LAMP_A1
  - stepId: STEP_WIRE_LAMP_RETURN
    instruction: "Lamba A2 terminalini PSU 0V ucuna ba\u011flay\u0131n."
    stepType: 1
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: LAMP_A2
    terminalIdB: PSU_0V
  - stepId: STEP_VALIDATE
    instruction: "10 kablo ba\u011flant\u0131s\u0131n\u0131 do\u011frulay\u0131n; ard\u0131ndan START/F1 \u00e7al\u0131\u015fma testine ge\u00e7in."
    stepType: 2
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: 
    terminalIdB: 
  - stepId: STEP_TEST_PSU_ON_FUSE_OFF
    instruction: "PSU'yu E ile a\u00e7\u0131n; F1 a\u00e7\u0131k, START b\u0131rak\u0131lm\u0131\u015f, K1 ve lamba kapal\u0131 olmal\u0131."
    stepType: 3
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: 
    terminalIdB: 
    powerSupplyState: 1
    fuseState: 2
    lampState: 2
    startButtonState: 2
    contactorState: 2
  - stepId: STEP_TEST_FUSE_ON_IDLE
    instruction: "F1 sigortas\u0131n\u0131 E ile kapat\u0131n. START'a bas\u0131lmadan K1 \u00e7ekmemeli, lamba s\u00f6n\u00fck kalmal\u0131."
    stepType: 3
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: 
    terminalIdB: 
    powerSupplyState: 1
    fuseState: 1
    lampState: 2
    startButtonState: 2
    contactorState: 2
  - stepId: STEP_TEST_START_PRESSED
    instruction: "START butonuna E ile BASILI TUTUN. K1 \u00e7ekmeli ve 23\u201324 NO konta\u011f\u0131ndan lamba yanmal\u0131."
    stepType: 3
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: 
    terminalIdB: 
    powerSupplyState: 1
    fuseState: 1
    lampState: 1
    startButtonState: 1
    contactorState: 1
  - stepId: STEP_TEST_START_RELEASED
    instruction: "START \u00fczerindeki E tu\u015funu BIRAKIN. M\u00fch\u00fcrleme olmad\u0131\u011f\u0131 i\u00e7in K1 b\u0131rakmal\u0131 ve lamba s\u00f6nmeli."
    stepType: 3
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: 
    terminalIdB: 
    powerSupplyState: 1
    fuseState: 1
    lampState: 2
    startButtonState: 2
    contactorState: 2
  - stepId: STEP_TEST_FUSE_OFF
    instruction: "START b\u0131rak\u0131lm\u0131\u015fken F1 sigortas\u0131n\u0131 E ile a\u00e7\u0131n. K1 ve lamba kapal\u0131 kalmal\u0131."
    stepType: 3
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: 
    terminalIdB: 
    powerSupplyState: 1
    fuseState: 2
    lampState: 2
    startButtonState: 2
    contactorState: 2
  - stepId: STEP_TEST_START_WITH_FUSE_OFF
    instruction: "F1 a\u00e7\u0131kken START butonuna E ile BASILI TUTUN. K1 \u00e7ekmemeli, lamba yanmamal\u0131."
    stepType: 3
    equipment: {fileID: 0}
    slotId: 
    terminalIdA: 
    terminalIdB: 
    powerSupplyState: 1
