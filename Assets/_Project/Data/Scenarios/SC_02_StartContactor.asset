    lampState: 2
    startButtonState: 1
    contactorState: 2
  - stepId: STEP_TEST_RELEASE_FUSE_OFF
    instruction: "START \u00fczerindeki E tu\u015funu BIRAKIN. F1 a\u00e7\u0131k ve sistem enerjisiz kalmal\u0131."
    stepType: 3
